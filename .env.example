# ─── GoHighLevel (GHL) Social Publishing ───────────────────────────
# Required for scheduling posts via /content-machine
# Create a Private Integration at: Settings → Integrations → Private Integrations
# Scopes needed: social-media-posting, medias, locations.readonly, users.readonly
GHL_API_KEY=your-ghl-private-integration-token
GHL_LOCATION_ID=your-ghl-sub-account-location-id

# ─── ElevenLabs TTS ────────────────────────────────────────────────
# Required only for AI-generated voiceover mode
# Get your key at: https://elevenlabs.io → Profile → API Keys
ELEVEN_API_KEY=your-elevenlabs-api-key

# ─── Higgsfield (Optional) ────────────────────────────────────────
# AI video/image generation via Higgsfield MCP or CLI
# Authenticate via: higgsfield auth login
# No env var needed — uses browser-based auth

# ─── Hyperframes (Optional) ───────────────────────────────────────
# HTML overlay renderer — installed separately
# No env var needed — runs as CLI tool
# Install: see https://github.com/AcmeVideoCommons/hyperframes
